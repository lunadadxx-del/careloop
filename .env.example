# Copy to .env and fill in. Demo mode needs nothing at all.
# Bedrock mode needs standard AWS credentials (env vars or ~/.aws/).

# bedrock | demo
CARELOOP_LLM_PROVIDER=demo

AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
CARELOOP_BEDROCK_MODEL=amazon.nova-lite-v1:0

# Local SQLite file (default: backend/careloop.db)
# CARELOOP_DB_PATH=

# Minutes after a scheduled dose before a missed dose escalates to caregivers
CARELOOP_GRACE_MINUTES=30
# Minutes a snoozed dose waits before reminding again
CARELOOP_SNOOZE_MINUTES=15
# Scheduler tick interval in seconds
CARELOOP_SCHEDULER_INTERVAL=30
